number = input("Enter a number to check if it is even or odd:")
if int(number) % 2 == 0:
    print(number + " is an even number.")
else:
    print(number + " is an odd number.")
while True:
    val = input("Enter a number to check if it is positive or negative (or 'exit' to quit):")
    if val == 'exit':
        print("Exiting the program.")
        print("goodbye!")
        break
    if int(val) >= 0:
        print(val + " is a positive number.")
    else:
        print(val + " is a negative number.")

